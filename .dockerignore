# Dependencies
node_modules
npm-debug.log
yarn-error.log
yarn.lock
# NOTE: package-lock.json MUST stay. Excluding it (as v1 did) silently downgrades the
# image build to a floating `npm install`, so the container's dependency versions are
# whatever resolved on the day it was built.

# Build outputs
.svelte-kit
build
.output
dist

# Development files
.env
.env.local
.env.*.local

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Git
.git
.gitignore
.gitattributes

# Documentation (optional - uncomment if you don't want docs in image)
# README.md
# docs

# Test files
*.test.js
*.spec.js
__tests__
coverage

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Misc
*.log
.cache

# Local data directory (will be mounted as volume)
data/*
!data/.gitkeep

# Temporary files
tmp
temp
*.tmp

# Alert rules can carry webhook secrets; ship only the example.
config/alerts.json
