{
  "name": "flux-flow-tracker",
  "version": "1.0.0",
  "description": "Flux Exchange Flow Analysis Dashboard",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch scripts/dev-api.ts",
    "dev:web": "vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "start": "node dist/server.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run format:check && npm run lint && npm run typecheck:server && npm run test"
  },
  "type": "module",
  "dependencies": {
    "@sveltejs/adapter-node": "^5.0.0",
    "@sveltejs/kit": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "express": "^4.18.2",
    "lucide-svelte": "^0.294.0",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.1",
    "globals": "^15.14.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte": "^4.2.8",
    "svelte-check": "^4.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^5.0.0",
    "vitest": "^2.1.8"
  }
}
