# FluxFlow configuration.
#
# Every value here is read at startup by src/lib/server/config.ts and validated.
# Copy to `.env` for local development: `cp .env.example .env`

# ── HTTP server ──────────────────────────────────────────────────────────────
# Single port serving both the API and the web app.
PORT=3000
HOST=0.0.0.0
# Set when the app is served from a different origin than the browser (e.g. behind a
# reverse proxy). Leave unset to allow same-origin only.
# ORIGIN=https://fluxflow.example.com

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/flux-flow.db
# Optional SQLite tuning knobs.
SQLITE_BUSY_TIMEOUT_MS=30000
# Log every SQL statement. Never enable in production.
DEBUG_SQL=0

# ── Data sources ─────────────────────────────────────────────────────────────
# The FluxNode pool is the primary source. Empty means "discovery disabled", in which
# case the app falls back to the FluxIndexer / Blockbook URLs below.
FLUX_NODE_POOL_URL=https://explorer.runonflux.io/api/status?q=getFluxNodes
# Optional dedicated indexer. Unset by default: no LAN addresses ship in the image.
# FLUX_INDEXER_URL=http://192.168.10.65:42067
BLOCKBOOK_URL=https://blockbook.runonflux.io
FLUX_NODES_API=https://explorer.runonflux.io/api/status?q=getFluxNodes
# Set to 0 to ignore these sources entirely (useful for UI-only development).
SYNC_ENABLED=1

# ── Sync ─────────────────────────────────────────────────────────────────────
# How often to ask for the chain tip, in seconds.
SYNC_POLL_SECONDS=30
# Blocks fetched per write transaction.
SYNC_BATCH_SIZE=250
# Max outbound chain requests in flight. Raise when using your own indexer.
SYNC_CONCURRENCY=16
# How far back to keep raw block/transaction data.
RETENTION_DAYS=180
# Re-check the last N block hashes each cycle to detect reorgs.
REORG_CHECK_DEPTH=10

# ── Classification ───────────────────────────────────────────────────────────
# Mountable label file so exchange/Foundation addresses can change without a rebuild.
LABELS_PATH=./config/labels.json
# Refresh the node operator list from explorer.runonflux.io this often.
NODE_REFRESH_SECONDS=600

# ── HTTP client (applies to every outbound call) ──────────────────────────────
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2
HTTP_RETRY_BASE_MS=500

# ── Observability ─────────────────────────────────────────────────────────────
# One of: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Pretty single-line logs for local development; set to 0 for structured JSON.
LOG_PRETTY=1

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED in production. Guards POST/PATCH/DELETE /api routes. 32+ random chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
