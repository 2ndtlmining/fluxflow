# FluxFlow configuration.
#
# Every value here is read at startup by src/lib/server/config.ts and validated.
# Copy to `.env` for local development: `cp .env.example .env`

# ── HTTP server ──────────────────────────────────────────────────────────────
# Single port serving both the API and the web app.
PORT=3000
HOST=0.0.0.0
# Set when the app is served from a different origin than the browser (e.g. behind a
# reverse proxy). Leave unset to allow same-origin only.
# ORIGIN=https://fluxflow.example.com

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_PATH=./data/flux-flow.db
# Optional SQLite tuning knobs.
SQLITE_BUSY_TIMEOUT_MS=30000
# Log every SQL statement. Never enable in production.
DEBUG_SQL=0

# ── Data sources ─────────────────────────────────────────────────────────────
# Preference order is: your own indexer (if set) → FluxNode pool → Blockbook.
# Optional: your own FluxNode's FluxOS API (needs insightexplorer=1). Trusted and tried
# first, ahead of the public pool, e.g. http://192.168.40.155:16127
# FLUX_NODE_URL=
# Optional dedicated indexer. Unset by default: no LAN addresses ship in the image.
# FLUX_INDEXER_URL=http://192.168.10.65:42067
# The public fallback. Rate-limits by IP, so it cannot sustain a backfill on its own.
BLOCKBOOK_URL=https://blockbook.runonflux.io
FLUX_NODES_API=https://explorer.runonflux.io/api/status?q=getFluxNodes
# Set to 0 to ignore these sources entirely (useful for UI-only development).
SYNC_ENABLED=1

# ── FluxNode pool ────────────────────────────────────────────────────────────
# Every FluxNode runs fluxd and FluxOS republishes its RPCs over HTTP, so block reads can
# be spread across thousands of operator-run nodes instead of one rate-limited host. This
# is the default source, needs no indexer, and is one request per block rather than one per
# transaction. Nothing here needs changing unless you want a different balance between
# speed and the load put on other people's connections.
# Where the candidate node list comes from.
FLUX_NODE_POOL_URL=https://explorer.runonflux.io/api/status?q=getFluxNodes
# 0 to fall back to Blockbook only.
FLUXNODE_POOL_ENABLED=1
# Nodes kept after probing. More nodes = faster sync, less pressure each.
FLUXNODE_POOL_SIZE=15
# Candidates probed before the fastest are kept. Probing thousands would be a scan.
FLUXNODE_PROBE_SAMPLE=60
# Max concurrent requests PER NODE. These are home connections, not our infrastructure.
FLUXNODE_MAX_INFLIGHT=2
# Daemon API ports to try per node. A node publishing its own port inline uses that.
FLUXNODE_API_PORTS=16127,16137,16147,16157,16167
# How often to re-discover and re-probe the node list.
FLUXNODE_DISCOVERY_SECONDS=1800
# How long a node is benched after a failure, timeout or wrong-height answer.
FLUXNODE_BENCH_SECONDS=120
# Discard a node whose tip is this far behind the pool median.
FLUXNODE_TIP_TOLERANCE=2
# Timeout for a liveness or capability probe. Probes must not stall a sync cycle.
FLUXNODE_PROBE_TIMEOUT_MS=5000
# Re-fetch every Nth block's hash from a second node to catch a node serving a wrong view.
# 0 disables the cross-check.
FLUXNODE_SPOTCHECK_EVERY=25

# ── Sync ─────────────────────────────────────────────────────────────────────
# How often to ask for the chain tip, in seconds.
SYNC_POLL_SECONDS=30
# Blocks fetched per write transaction.
SYNC_BATCH_SIZE=250
# Max outbound chain requests in flight, shared by every data source.
SYNC_CONCURRENCY=16
# How far back to keep raw block/transaction data.
RETENTION_DAYS=180
# Re-check the last N block hashes each cycle to detect reorgs.
REORG_CHECK_DEPTH=10

# ── Classification ───────────────────────────────────────────────────────────
# Mountable label file so exchange/Foundation addresses can change without a rebuild.
LABELS_PATH=./config/labels.json
# Refresh node-operator labels (node list from FLUX_NODE_URL, else the explorer) this often.
NODE_REFRESH_SECONDS=600
# Address intelligence: node operators, clustering candidates, exchange hops (#18-#20).
INTEL_ENABLED=1
# How often clustering and exchange-candidate detection run.
INTEL_CLUSTER_SECONDS=1800
# A withdrawal re-deposited within this many blocks is an exchange hop (240 = ~2 hours).
INTEL_HOP_MAX_BLOCKS=240

# ── HTTP client (applies to every outbound call) ──────────────────────────────
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2
HTTP_RETRY_BASE_MS=500

# ── Observability ─────────────────────────────────────────────────────────────
# One of: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Pretty single-line logs for local development; set to 0 for structured JSON.
LOG_PRETTY=1

# ── Live updates & alerts ────────────────────────────────────────────────────
# Alert rules and channels (see config/alerts.example.json). Missing file = alerts off.
ALERTS_PATH=./config/alerts.json
# Flows at least this large (FLUX) are pushed to /api/stream as `flow` events.
LIVE_FLOW_MIN_FLUX=1000
# Concurrent /api/stream subscribers.
LIVE_MAX_CLIENTS=100
# Secrets referenced from alerts.json as "env:NAME", e.g.:
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Security ─────────────────────────────────────────────────────────────────
# REQUIRED in production. Guards POST/PATCH/DELETE /api routes. 32+ random chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Per-IP rate limit on /api: sustained requests/second and burst. 0 disables.
API_RATE_LIMIT_RPS=10
API_RATE_LIMIT_BURST=60
# Set to 1 only behind a reverse proxy you run, so client IPs come from X-Forwarded-For.
TRUST_PROXY=0
