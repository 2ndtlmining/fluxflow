# FluxFlow settings for `docker compose` / deploy/redeploy.sh.
#
#   cp .env.example.compose .env
#
# Paths, port and NODE_ENV inside the container are fixed in docker-compose.yml.
# Every other variable from .env.example can be added here.

# REQUIRED. Guards admin endpoints; production refuses to start without it (32+ chars).
# Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Host port the dashboard and API are published on.
PORT=3000

# Optional: your own FluxNode's FluxOS API (needs insightexplorer=1). Tried first; the public
# FluxNode pool is the fallback.
# FLUX_NODE_URL=http://192.168.40.155:16127

# Optional: your own indexer. Leave unset to use the public FluxNode pool.
# FLUX_INDEXER_URL=http://192.168.10.65:42067

RETENTION_DAYS=180
SYNC_POLL_SECONDS=30
SYNC_BATCH_SIZE=250
SYNC_CONCURRENCY=16
LOG_LEVEL=info
